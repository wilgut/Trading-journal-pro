# Database
DATABASE_URL="postgresql://user:password@localhost:5432/trading_journal"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Insider-Buy Monitor ────────────────────────────────────────────────────

# SEC EDGAR User-Agent (required by SEC — use your real company/email)
EDGAR_USER_AGENT="YourApp contact@yourdomain.com"

# Slack bot token (xoxb-...) with chat:write scope
SLACK_BOT_TOKEN="xoxb-your-bot-token"

# Slack channel to post the insider-buy summary into
SLACK_CHANNEL_ID="C0ATEAY4P6H"

# Optional: protect the /api/insider-buys endpoint
CRON_SECRET="your-cron-secret"
