# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/trading_journal"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Insider Purchase Monitor (scripts/insider-purchases.ts) ───────────────────

# Slack Incoming Webhook URL — create one at https://api.slack.com/apps
# Leave blank to print the summary to stdout instead.
SLACK_WEBHOOK_URL=""

# Minimum purchase value to include in the report (default: 100000)
EDGAR_MIN_PURCHASE="100000"

# EDGAR requires a User-Agent header with your app name and contact email.
# See: https://www.sec.gov/developer
EDGAR_USER_AGENT="TradingJournalPro your-email@example.com"
