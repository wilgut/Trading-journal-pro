# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/trading_journal"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# SEC EDGAR — User-Agent required by SEC fair-use policy
# Format: "AppName/Version contact@email.com"
SEC_USER_AGENT="TradingJournalPro/1.0 your@email.com"

# Slack — Incoming Webhook URL for insider purchase alerts
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T.../B.../..."
