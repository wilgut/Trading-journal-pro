# ── SEC EDGAR Insider Tracker ─────────────────────────────────────────────────
# Required by EDGAR's acceptable-use policy: identify your app + contact email.
EDGAR_USER_AGENT="Trading-Journal-Pro admin@example.com"

# Slack incoming webhook URL (create one at api.slack.com/apps → Incoming Webhooks)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_WORKSPACE/YOUR_CHANNEL/YOUR_TOKEN

# Optional overrides
LOOKBACK_HOURS=24          # hours of EDGAR history to scan (default 24)
MIN_PURCHASE_USD=100000    # minimum purchase value in USD (default 100000)

# ── Next.js / App ──────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/trading_journal
