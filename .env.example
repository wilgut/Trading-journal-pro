# Database
DATABASE_URL="postgresql://user:password@localhost:5432/trading_journal"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# SEC EDGAR (required — SEC policy mandates an identifying User-Agent)
# Format: "AppName your@email.com"
SEC_USER_AGENT="TradingJournalPro your@email.com"

# Slack
# Create an Incoming Webhook at https://api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/XXX/YYY/ZZZ"
