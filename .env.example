# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/trading_journal"

# ── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── SEC Insider Purchase Tracker ─────────────────────────────────────────────
# Slack Incoming Webhook URL — required for insider-tracker script & API route.
# Create one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T.../B.../..."

# Optional: simple bearer token to protect the /api/insider-purchases endpoint.
# Leave blank to disable authentication on that route.
INSIDER_API_KEY=""

# Optional: max Form 4 filings to scan per run.
# Script default: 500  |  API route default: 100
INSIDER_MAX_FILINGS=""
