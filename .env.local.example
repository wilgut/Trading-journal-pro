# ─────────────────────────────────────────────────────────────────────────────
#  Environment Variables — copy to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Slack (at least one method required for notifications) ────────────────────

# Option A: Incoming Webhook URL (simplest — no scopes needed)
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Option B: Bot token + channel (more flexible)
# Create at: https://api.slack.com/apps → OAuth & Permissions → chat:write scope
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#trading-alerts

# ── SEC EDGAR ─────────────────────────────────────────────────────────────────
# SEC requires a valid contact email in the User-Agent header (per their TOS)
CONTACT_EMAIL=your@email.com

# ── Optional ──────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://...
# NEXTAUTH_SECRET=...
# NEXTAUTH_URL=http://localhost:3000
